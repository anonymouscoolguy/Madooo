# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold real values.

# API-Football, from https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Neon, pooled connection strings (the hostname contains "-pooler").
# One per branch — a Neon branch is a separate endpoint, so there is no way to
# select one from a single URL. The direct connection string that migrations
# need is derived from these by dropping "-pooler" from the hostname.
#
# End these with sslmode=verify-full, not the sslmode=require Neon hands you.
# pg treats "require" as "verify-full" today but warns that it will adopt
# libpq's weaker meaning — encrypt without verifying who answered — in v9.
# Spelling out what is already happening keeps that upgrade from silently
# downgrading the connection.
DATABASE_URL=
DATABASE_URL_DEV=

# Everything defaults to the development branch. Set this to "production" only
# once a production branch exists, and only in the deployed environment; it
# should never be set on a developer's machine.
# DATABASE_TARGET=production

# A Vercel environment wants DATABASE_URL_DEV and SEASON, and nothing else. The
# deployment reads the development branch for now, so it needs the same two
# variables a laptop does. API_FOOTBALL_KEY is deliberately withheld there —
# nothing may call API-Football during a page render, and a missing key makes
# any code that tries fail loudly instead of quietly spending quota.

# Escape hatches, only needed if Neon ever stops deriving its direct endpoint
# from the pooled hostname. Leave unset.
# DATABASE_URL_UNPOOLED=
# DATABASE_URL_DEV_UNPOOLED=

# The season to run against. Development uses 2024 because API-Football's free
# tier only serves 2022-2024. Never hardcode this anywhere.
SEASON=2024

# Clerk, from https://dashboard.clerk.com. The publishable key is inlined into
# the browser bundle by the NEXT_PUBLIC_ prefix and is meant to be public — it
# identifies the Clerk instance, it does not authorise anything. The secret key
# must never carry that prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the modal sends people once they are signed in. Without these you stay
# on the landing page after signing in, since the modal never navigated. There
# is deliberately no NEXT_PUBLIC_CLERK_SIGN_IN_URL: sign-in is a modal, not a
# route, so pointing Clerk at a page that does not exist would 404.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/fixtures
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/fixtures

# Vercel needs all four of the above in addition to DATABASE_URL_DEV and SEASON.
